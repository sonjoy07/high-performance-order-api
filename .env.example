NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_api

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

JWT_SECRET=change-me
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# Order & Inventory Configuration
STOCK_RESERVATION_MINUTES=30
IDEMPOTENCY_KEY_TTL_HOURS=24

# Query Optimization / Reporting
# IANA timezone used to resolve date-only report filters (fromDate / toDate).
# toDate=<day> expands to the end of that day in this zone.
# Must be a valid IANA zone, e.g. UTC, Asia/Colombo, America/New_York.
TIMEZONE=UTC

# Development-only Prisma SQL logging. Every statement is logged, so leave this off
# unless you are profiling queries; it is force-disabled when NODE_ENV=production.
PRISMA_LOG_QUERIES=false

