# ─────────────────────────────────────────────────────────────────────────────
# high-performance-order-api — Environment Configuration
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.
# In production, inject variables through a secrets manager or CI environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Local development:  postgresql://postgres:postgres@localhost:5432/order_api
# Docker Compose:     postgresql://postgres:postgres@postgres:5432/order_api
# ⚠ Production: use strong credentials and a secrets manager
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_api

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local development:  redis://localhost:6379
# Docker Compose:     redis://redis:6379
# ⚠ Production: add authentication (redis://:password@host:port)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ── Queue / Worker ────────────────────────────────────────────────────────────
QUEUE_PREFIX=high-performance-order-api
WORKER_CONCURRENCY=5

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# ⚠ MUST be changed before going to production.
# Use at least 32 cryptographically random characters.
# Example: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# ── Order & Inventory ─────────────────────────────────────────────────────────
STOCK_RESERVATION_MINUTES=30
IDEMPOTENCY_KEY_TTL_HOURS=24

# ── Reporting ─────────────────────────────────────────────────────────────────
# IANA timezone used to resolve date-only report filters (fromDate / toDate).
# Must be a valid IANA zone, e.g. UTC, Asia/Colombo, America/New_York.
TIMEZONE=UTC

# ── Prisma SQL Logging ────────────────────────────────────────────────────────
# Set to true ONLY for local query profiling. Force-disabled in production.
PRISMA_LOG_QUERIES=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

ORDER_RATE_LIMIT_WINDOW_MS=60000
ORDER_RATE_LIMIT_MAX_REQUESTS=20

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Example for multiple origins: http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# ── Request Body ──────────────────────────────────────────────────────────────
BODY_LIMIT=1mb
