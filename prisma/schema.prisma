// Prisma schema for high-performance-order-api
// Production-oriented PostgreSQL database schema for order processing and inventory management

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// Enums
// ==========================================

enum UserRole {
  ADMIN
  CUSTOMER
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  RESERVATION
  RELEASE
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

// ==========================================
// User & Customer Models
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer      Customer?
  refreshTokens RefreshToken[]

  // ADMIN order search by customer email uses ILIKE '%term%'. The unique B-tree on
  // `email` cannot serve a leading-wildcard match, so a trigram GIN index is added.
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

model Customer {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders          Order[]
  idempotencyKeys IdempotencyKey[]

  @@map("customers")
}

// ==========================================
// Catalog Models
// ==========================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  slug        String   @unique
  description String?
  sku         String   @unique
  price       Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  stockReservations  StockReservation[]

  // ── Catalogue read path ──────────────────────────────────────────────────
  // Category browse + default "newest first" ordering in ONE index, and the `id`
  // tiebreaker that makes LIMIT/OFFSET ordering total.
  @@index([categoryId, createdAt, id])
  // Global "newest first" catalogue ordering (no category filter).
  @@index([createdAt])
  // Search uses case-insensitive ILIKE '%term%', which a B-tree cannot serve.
  // pg_trgm GIN indexes make substring search index-backed instead of a full scan.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  // NOTE: the previous single-column index on `isActive` was intentionally removed —
  // a boolean has ~no selectivity, so the planner never chose it; the filter costs one
  // cheap heap predicate. See README → Database Index Review.
  @@map("products")
}

// ==========================================
// Inventory Models
// ==========================================

model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // NOTE: the previous `@@index([productId])` was removed. It duplicated the b-tree
  // already created by the `@unique` constraint on `productId`, costing write
  // amplification and storage for zero planner benefit.
  @@map("inventories")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  productId     String
  type          InventoryMovementType
  quantity      Int
  referenceType String
  referenceId   String?
  createdAt     DateTime              @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Real query shape: `WHERE productId = ? [AND type = ?] [AND createdAt BETWEEN ?]`
  // `ORDER BY createdAt DESC LIMIT ?` — served by one composite index, which also
  // replaces the previous separate `[productId]` and `[createdAt]` indexes.
  @@index([productId, createdAt])
  @@map("inventory_movements")
}

// ==========================================
// Order Models
// ==========================================

model Order {
  id          String      @id @default(uuid())
  customerId  String
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  stockReservations StockReservation[]

  // ── Three concrete access paths, three matching indexes ───────────────────
  // 1. CUSTOMER order list:  WHERE customerId = ? [AND status = ?] [AND createdAt BETWEEN ?]
  //    [AND totalAmount BETWEEN ?]  ORDER BY createdAt DESC, id DESC  → (customerId, createdAt, id)
  // 2. ADMIN filtered list:   WHERE status = ? ORDER BY createdAt DESC, id DESC → (status, createdAt, id)
  // 3. ADMIN global list + every date-range report: ORDER BY createdAt DESC, id DESC
  //    → (createdAt, id)
  // Each composite index also makes the corresponding single-column index redundant, so
  // the old `[customerId]`, `[status]` and `[createdAt]` indexes were dropped.
  @@index([customerId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([createdAt, id])
  // ADMIN search by order number uses ILIKE '%term%'; pg_trgm makes it index-backed.
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // `[orderId]` serves the order-detail projection; `[productId]` serves the product
  // sales report join plus referential-integrity checks. Both are real access paths,
  // so both indexes are retained.
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?
  changedAt  DateTime     @default(now())
  reason     String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Real query shape: `WHERE orderId = ? ORDER BY changedAt ASC`. The composite index
  // replaces the previous separate `[orderId]` and `[changedAt]` indexes (each was a
  // strict prefix of it) and additionally makes the ordering free of a Sort node.
  @@index([orderId, changedAt])
  @@map("order_status_history")
}

// ==========================================
// Stock Reservation & Idempotency Models
// ==========================================

model StockReservation {
  id         String            @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Hot path: cancellation reads `WHERE orderId = ? AND status = 'ACTIVE'` to find the
  // reservations to release. A composite index answers that in one probe and drops the
  // previous standalone `[orderId]` and `[status]` indexes.
  @@index([orderId, status])
  // Referential-integrity checks + `productId`-scoped reservation lookups.
  @@index([productId])
  // Reservation expiry sweeps.
  @@index([expiresAt])
  @@map("stock_reservations")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String
  customerId     String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ==========================================
// Authentication & Session Models
// ==========================================

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ==========================================
// Queue & Worker Models
// ==========================================

/// Tracks which BullMQ jobs have been successfully processed by a worker.
/// Used to implement worker-side idempotency: if a job with the same eventId
/// and eventType is received again (e.g. due to at-least-once delivery),
/// the worker can detect the duplicate and skip re-processing.
model ProcessedJob {
  id          String   @id @default(uuid())
  eventId     String
  eventType   String
  processedAt DateTime @default(now())

  @@unique([eventId, eventType])
  @@index([processedAt])
  @@map("processed_jobs")
}
